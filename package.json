{
  "name": "crud-api",
  "version": "1.0.0",
  "description": "No description yet",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node dist/app.js",
    "start:dev": "tsx watch src/app.ts",
    "start:prod": "npm run build && node dist/app.js",
    "start:multi": "node dist/cluster.js",
    "start:db": "node dist/db-server.js",
    "test": "vitest run --exclude src/cluster.test.ts",
    "test:cluster": "vitest run src/cluster.test.ts",
    "test:all": "vitest run",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prod": "tsc",
    "build": "webpack --mode=production"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freennnn/crud-api.git"
  },
  "author": "apranevich",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/freennnn/crud-api/issues"
  },
  "homepage": "https://github.com/freennnn/crud-api#readme",
  "engines": {
    "node": ">=24.10.0"
  },
  "dependencies": {
    "dotenv": "^16.4.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3",
    "vitest": "^3.1.3",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4"
  }
}